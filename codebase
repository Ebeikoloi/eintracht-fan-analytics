3. src/generate_data.py
Since real fan data is not public, you generate a realistic synthetic dataset.
Be honest about this in the README — it’s a standard practice for portfolio projects.

"""Generate synthetic Eintracht Frankfurt fan dataset for portfolio project."""
import numpy as np
import pandas as pd

np.random.seed(42)
N = 10000

df = pd.DataFrame({
    "fan_id": range(1, N + 1),
    "age": np.random.randint(18, 75, N),
    "membership_years": np.random.randint(0, 30, N),
    "matches_attended_last_season": np.random.poisson(8, N),
    "social_engagement_score": np.random.uniform(0, 100, N).round(1),
    "merch_spend_eur": np.random.gamma(2, 40, N).round(2),
    "ticket_spend_eur": np.random.gamma(3, 60, N).round(2),
    "newsletter_opens": np.random.poisson(12, N),
    "app_logins_last_90d": np.random.poisson(15, N),
})

# Churn logic: low engagement + low spend + few matches = higher churn
churn_score = (
    -0.05 * df["matches_attended_last_season"]
    - 0.02 * df["social_engagement_score"]
    - 0.001 * df["merch_spend_eur"]
    - 0.03 * df["app_logins_last_90d"]
    + 0.02 * df["age"]
    + np.random.normal(0, 1, N)
)
df["churned"] = (churn_score > np.percentile(churn_score, 75)).astype(int)

df.to_csv("data/raw/fans.csv", index=False)
print(f"Generated {len(df)} fan records. Churn rate: {df['churned'].mean():.1%}")

